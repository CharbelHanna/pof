{
  "name": "pof",
  "version": "0.0.0",
  "private": true,
  "description": "Point of Focus — photoshoot planning for photographers: campaigns, shoots, sessions and reusable session templates.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @pof/db generate",
    "db:migrate": "pnpm --filter @pof/db migrate",
    "db:seed": "pnpm --filter @pof/core seed",
    "db:studio": "pnpm --filter @pof/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@pof/tsconfig": "workspace:*",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.0",
    "typescript": "^5.9.3"
  }
}
