# Copy to .env and fill in. Never commit .env.
# Every value here is a plain environment variable by design — no platform
# secret-manager SDK appears in application code, so any host works.

NODE_ENV=development
LOG_LEVEL=debug

# Port the web app is published on. docker-compose reads this file, so this
# single value sets both the published port and the origin the app believes
# it is served from — change it here only, never in docker-compose.yml.
#
# If port 3000 is already taken, set WEB_PORT=4000 and leave APP_URL alone;
# it derives from WEB_PORT. They must agree, because Better Auth validates
# callbacks against APP_URL.
WEB_PORT=3000
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# These URLs are for tools run ON THE HOST: `pnpm db:migrate`, `pnpm db:seed`,
# `pnpm dev`. They reach Postgres through the port compose publishes, hence
# `@localhost`.
#
# Services running INSIDE compose (web, worker, migrate) do NOT use these.
# Containers reach each other by service name, so their URLs say `@postgres`
# and are set in docker-compose.yml. That difference is why the two cannot be
# a single value.
#
# DATABASE_URL must use pof_app — the unprivileged LOGIN role, which inherits
# its privileges from the app_user permission role. RLS is silently bypassed
# for table owners and superusers, so pointing this at pof_owner would
# disable tenant isolation with no visible error.
#
# Note: `app_user` is NOLOGIN and cannot be connected as directly; it is a
# permission set, not an account. See db/init/01-roles.sh.
DATABASE_URL=postgresql://pof_app:app_password@localhost:5432/pof
# Used only by `pnpm db:migrate` — owns the schema, runs DDL.
DATABASE_MIGRATION_URL=postgresql://pof_owner:owner_password@localhost:5432/pof

# --- Auth ---------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Object storage (S3-compatible) -------------------------------------
# Defaults below match the MinIO service in docker-compose.yml.
# For Cloudflare R2: set STORAGE_ENDPOINT to the R2 S3 endpoint, drop
# STORAGE_FORCE_PATH_STYLE, and point STORAGE_PUBLIC_URL at the custom domain.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=pof-assets
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/pof-assets

# --- Mail ---------------------------------------------------------------
# "console" prints mail to stdout and is rejected in production.
MAIL_PROVIDER=console
MAIL_FROM=noreply@pof.local
# MAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_PROVIDER=resend
# RESEND_API_KEY=

# --- Observability ------------------------------------------------------
# SENTRY_DSN=

# --- Geocoding ----------------------------------------------------------
# Every free provider has a usage policy rather than a licence, so this is
# configuration. 'photon' supports autocomplete and is the default;
# 'nominatim' is stricter (1 req/sec, no autocomplete) but reachable on
# networks where Photon is not; 'none' disables place search entirely —
# locations can still be entered by coordinates and sun times still work,
# because they are computed locally.
# Production should self-host or use a paid provider via GEOCODING_BASE_URL.
GEOCODING_PROVIDER=photon

# GEOCODING_BASE_URL=
