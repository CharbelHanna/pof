# Copy to .env and fill in. Never commit .env.
# Every value here is a plain environment variable by design — no platform
# secret-manager SDK appears in application code, so any host works.

NODE_ENV=development
LOG_LEVEL=debug

# Port the web app is published on. docker-compose reads this file, so this
# single value sets both the published port and the origin the app believes
# it is served from — change it here only, never in docker-compose.yml.
#
# If port 3000 is already taken, set WEB_PORT=4000 and leave APP_URL alone;
# it derives from WEB_PORT. They must agree, because Better Auth validates
# callbacks against APP_URL.
WEB_PORT=3000
APP_URL=http://localhost:3000

# Extra origins allowed to drive authenticated requests, comma-separated.
# APP_URL is always trusted; this only widens the set.
#
# Reaching the stack by any other name — your host's LAN IP from a phone, a
# tunnel hostname — otherwise fails sign-in with "Invalid origin", because
# Better Auth checks the browser's Origin header against this list. Setting
# it here keeps localhost working at the same time.
#
# Wildcards are supported, so a DHCP range can be covered in one entry:
#   AUTH_TRUSTED_ORIGINS=http://192.168.1.*:3000
# Leave empty in production: each entry is an origin trusted for CSRF.
AUTH_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# These URLs are for tools run ON THE HOST: `pnpm db:migrate`, `pnpm db:seed`,
# `pnpm dev`. They reach Postgres through the port compose publishes, hence
# `@localhost`.
#
# Services running INSIDE compose (web, worker, migrate) do NOT use these.
# Containers reach each other by service name, so their URLs say `@postgres`
# and are set in docker-compose.yml. That difference is why the two cannot be
# a single value.
#
# DATABASE_URL must use pof_app — the unprivileged LOGIN role, which inherits
# its privileges from the app_user permission role. RLS is silently bypassed
# for table owners and superusers, so pointing this at pof_owner would
# disable tenant isolation with no visible error.
#
# Note: `app_user` is NOLOGIN and cannot be connected as directly; it is a
# permission set, not an account. See db/init/01-roles.sh.
DATABASE_URL=postgresql://pof_app:app_password@localhost:5432/pof
# Used only by `pnpm db:migrate` — owns the schema, runs DDL.
DATABASE_MIGRATION_URL=postgresql://pof_owner:owner_password@localhost:5432/pof

# --- Auth ---------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Object storage (S3-compatible) -------------------------------------
# Defaults below match the MinIO service in docker-compose.yml.
# For Cloudflare R2: set STORAGE_ENDPOINT to the R2 S3 endpoint, drop
# STORAGE_FORCE_PATH_STYLE, and point STORAGE_PUBLIC_URL at the custom domain.
# These must match storage/s3-identities.json, which is what the local
# SeaweedFS container actually accepts. They previously read `minioadmin` on
# port 9000 — left over from MinIO, which was replaced in September 2026 —
# and nothing noticed until uploads existed, because nothing touched storage
# before then. A mismatch surfaces as `InvalidAccessKeyId` on upload.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=auto
STORAGE_BUCKET=pof-assets
STORAGE_ACCESS_KEY_ID=pofdev
STORAGE_SECRET_ACCESS_KEY=pofdevsecret
# SeaweedFS addresses buckets by path, as MinIO did; AWS and R2 do not.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:8333/pof-assets

# Where a BROWSER uploads to, when that differs from the server's endpoint.
# Inside docker-compose the server reaches storage at http://storage:8333 on
# the compose network, which a browser cannot resolve — and a presigned URL
# signs its host, so one signed for the internal name is unusable. Compose
# sets this for you; it matters only if you run the web app outside compose.
# STORAGE_PUBLIC_ENDPOINT=http://localhost:8333

# --- Mail ---------------------------------------------------------------
# Password reset needs working mail. Two local options, neither requiring an
# account anywhere:
#
#   smtp    -> the Mailpit container in docker-compose. Read the mail in a
#              browser at http://localhost:8025. Use this when working on the
#              mail itself: it exercises the real SMTP path and renders the
#              HTML part.
#   console -> prints the text part to the container log. Zero moving parts,
#              but you never see the email as a recipient would.
#
# "console" DISCARDS mail, so the app refuses to boot with it once APP_URL is
# not local — otherwise a deployed app would silently drop password resets.
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@pof.local
# Service name on the compose network; Mailpit needs no credentials.
SMTP_HOST=mail
SMTP_PORT=1025

# Host-side tools (outside the compose network) reach Mailpit on localhost:
# SMTP_HOST=localhost

# For real delivery, either point SMTP_HOST at a relay (Azure Communication
# Services, Postmark, Fastmail) or switch to Resend:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
#
# Whichever you choose, deliverability is DNS work, not code: without SPF,
# DKIM and DMARC on a domain you control, reset emails land in spam.

# --- Observability ------------------------------------------------------
# SENTRY_DSN=

# --- Geocoding ----------------------------------------------------------
# Every free provider has a usage policy rather than a licence, so this is
# configuration. 'photon' supports autocomplete and is the default;
# 'nominatim' is stricter (1 req/sec, no autocomplete) but reachable on
# networks where Photon is not; 'none' disables place search entirely —
# locations can still be entered by coordinates and sun times still work,
# because they are computed locally.
# Production should self-host or use a paid provider via GEOCODING_BASE_URL.
GEOCODING_PROVIDER=photon

# GEOCODING_BASE_URL=
