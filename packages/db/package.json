{
  "name": "@pof/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/global-setup": "./src/testing/global-setup.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "studio": "tsx --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pof/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@pof/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/node": "^24.9.2",
    "drizzle-kit": "0.31.11",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
