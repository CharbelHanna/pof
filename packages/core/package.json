{
  "name": "@pof/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ports": "./src/ports/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "clean": "rimraf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@pof/db": "workspace:*",
    "@pof/schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@pof/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "11.7.1",
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^8.0.2",
    "postgres": "3.4.9",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.2.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
